#!/usr/bin/env python3
"""mala-pata-notify — agent-agnostic desktop notification entrypoint.

One command every AI CLI can call from its own hook/notify mechanism. It reads
the agent's event payload (stdin JSON, or argv JSON for Codex's legacy notify),
resolves a session identity, and fires the mala-pata overlay + a sound.

Usage:
  <agent hook> | mala-pata-notify --event finished|waiting --agent <name>
  mala-pata-notify --event finished --agent codex --argv-json '<json>'

Contract (why it is safe to wire into any host):
  - Reads stdin ONCE; tolerates empty/invalid JSON.
  - Prints NOTHING to stdout and always exits 0, so it never pollutes a host
    that parses hook stdout (Gemini/Kimi) nor blocks a blockable Stop hook.
  - Overlay + sound run detached (new session) so they survive the hook exit.

Identity resolution:
  - Universal fallback (works for EVERY agent, since every payload carries cwd):
    project = basename(cwd), git branch, agent, HH:MM.
  - Per-agent enricher: claude-code reuses the existing malapata_session_name.py
    to keep its richer line (msg count + last prompt). Other agents can get their
    own enricher later; without one they use the fallback.

Overridable via env:
  MALAPATA_OVERLAY_BIN   (default ~/.claude/hooks/malapata_overlay)
  MALAPATA_SND_FINISHED  (if set, forces one sound; else random from FINISHED_POOL)
  MALAPATA_SND_WAITING   (if set, forces one sound; else random from WAITING_POOL)
"""
import json
import os
import random
import shutil
import subprocess
import sys
from datetime import datetime

OVERLAY = os.environ.get(
    "MALAPATA_OVERLAY_BIN", os.path.expanduser("~/.claude/hooks/malapata_overlay")
)
SESSION_NAME = os.path.expanduser("~/.claude/hooks/malapata_session_name.py")
SND_DIR = "/System/Library/Sounds"
# Each event picks a RANDOM sound from its own disjoint pool, so "finished" and
# "waiting" still sound different. Env MALAPATA_SND_FINISHED / MALAPATA_SND_WAITING,
# if set, forces a single fixed sound for that event (overrides the pool).
FINISHED_POOL = ["Glass", "Bottle", "Pop", "Purr", "Ping"]
WAITING_POOL = ["Submarine", "Morse", "Frog", "Blow"]
THEMES = ["glass", "frost", "frostw"]


def pick_sound(event):
    env = os.environ.get("MALAPATA_SND_WAITING" if event == "waiting" else "MALAPATA_SND_FINISHED")
    if env:
        return env
    pool = WAITING_POOL if event == "waiting" else FINISHED_POOL
    return f"{SND_DIR}/{random.choice(pool)}.aiff"


def parse_args(argv):
    event, agent, argv_json, rest = None, "unknown", False, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--event" and i + 1 < len(argv):
            event = argv[i + 1]
            i += 2
        elif a == "--agent" and i + 1 < len(argv):
            agent = argv[i + 1]
            i += 2
        elif a == "--argv-json":
            argv_json = True
            i += 1
        else:
            rest.append(a)
            i += 1
    return event, agent, argv_json, rest


def read_payload(argv_json, rest):
    raw = ""
    if argv_json:
        raw = rest[-1] if rest else ""
    else:
        try:
            raw = sys.stdin.read()
        except Exception:
            raw = ""
    try:
        data = json.loads(raw) if raw.strip() else {}
        if not isinstance(data, dict):
            data = {}
    except Exception:
        data = {}
    return raw, data


def first(d, *keys):
    for k in keys:
        v = d.get(k)
        if v:
            return v
    return ""


def git_branch(cwd):
    if not cwd or not os.path.isdir(cwd):
        return ""
    try:
        return subprocess.run(
            ["git", "-C", cwd, "branch", "--show-current"],
            capture_output=True, text=True, timeout=3,
        ).stdout.strip()
    except Exception:
        return ""


def claude_enrich(raw):
    """Reuse the existing Claude session-name resolver (reads the same stdin JSON)."""
    if not os.path.isfile(SESSION_NAME):
        return "", "", ""
    try:
        out = subprocess.run(
            ["python3", SESSION_NAME], input=raw,
            capture_output=True, text=True, timeout=5,
        ).stdout.splitlines()
    except Exception:
        out = []
    big = out[0].strip() if len(out) > 0 else ""
    l1 = out[1].strip() if len(out) > 1 else ""
    l2 = out[2].strip() if len(out) > 2 else ""
    return big, l1, l2


def overlay_slot():
    try:
        out = subprocess.run(
            ["pgrep", "-f", "malapata_overlay"],
            capture_output=True, text=True, timeout=3,
        ).stdout
        return str(len([x for x in out.splitlines() if x.strip()]))
    except Exception:
        return "0"


def fire(cmd):
    try:
        subprocess.Popen(
            cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass


def main():
    event, agent, argv_json, rest = parse_args(sys.argv[1:])
    raw, data = read_payload(argv_json, rest)

    cwd = first(data, "cwd", "workdir")
    project = os.path.basename(cwd.rstrip("/")) if cwd else ""
    branch = git_branch(cwd)
    hhmm = datetime.now().strftime("%H:%M")
    meta = " · ".join([x for x in [project or "?", branch, agent, hhmm] if x])

    # Universal fallback (works for any agent).
    big = project or agent or "mala-pata"
    line2 = meta
    if event == "waiting":
        line1 = "te espera — input requerido"
        sound = pick_sound("waiting")
    else:  # finished / default
        line1 = "terminó"
        sound = pick_sound("finished")

    # Per-agent enricher: claude-code keeps its richer rendering.
    if agent == "claude-code":
        b, l1, l2 = claude_enrich(raw)
        if b:
            big = b
        if event == "waiting":
            if l1:
                line2 = l1
        else:
            if l1:
                line1 = l1
            if l2:
                line2 = l2

    theme = random.choice(THEMES)
    slot = overlay_slot()

    if os.path.exists(sound) and shutil.which("afplay"):
        fire(["afplay", sound])
    if os.path.exists(OVERLAY):
        fire([OVERLAY, big, theme, slot, line1, line2])

    sys.exit(0)


if __name__ == "__main__":
    main()
